# -------------------------
# Root .gitignore for TradeFlow NG
# Covers backend (Python/FastAPI) and frontend (Next.js) plus IDE/OS files
# -------------------------

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pdb
*.sqlite3
*.db
.python-version
.env
.env.*
venv/
.venv/
venv.bak/
pip-wheel-metadata/
*.egg-info/
.eggs/
build/
dist/
htmlcov/
.coverage
.coverage.*
.pytest_cache/
.tox/
.mypy_cache/
.pytype/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
# Local envs for Next.js
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and runtime files
logs/
*.log
debug.log

# OS files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Containers / CI local files
docker-compose.override.yml
.env.build

# Secrets / keys
*.pem
*.key
secrets/
credentials.json

# Coverage / reports
coverage/
coverage-html/
/report/

# Misc
*.bak
*.tmp
*.old
*.orig
